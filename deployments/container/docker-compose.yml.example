# -*- mode: yaml-*-
# vim: ft=yaml

version: '3'

services:
  teleirc:
    build:
      context: ../../
      dockerfile: ./deployments/container/Dockerfile
    env_file: ../../.env
    # Read configuration from the environment instead of the image's default -conf file.
    command: ["-debug", "true"]
    user: teleirc-user
